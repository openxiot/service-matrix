{
  "id": "xxxx",
  "name": "1 号冷水机组",
  "version": 2,
  "configSnapshot": {
    "id": "65f0c0ffee0123456789abcd",
    "slave": {
      "manufacturer": "厂家",
      "model": "型号",
      "slaveId": 1
    },
    "registries": [
      {
        "name": "进水温度",
        "index": 1,
        "address": 0,
        "area": "holding",
        "dataType": "uint16",
        "access": "R",
        "scale": 0.1,
        "unit": "℃",
        "alarms": [
          {
            "id": "a1",
            "enabled": true,
            "compare": ">",
            "threshold": 80,
            "level": "WARN",
            "text": "进水温度过高"
          }
        ]
      },
      {
        "name": "进水阀",
        "index": 2,
        "address": 0,
        "area": "coil",
        "access": "R",
        "alarms": [
          {
            "id": "b1",
            "enabled": true,
            "compare": "=",
            "threshold": 1,
            "level": "CRITICAL",
            "text": "进水阀未关闭"
          }
        ]
      }
    ],
    "commands": [],
    "lifecycle": "development"
  },
  "slaveId": 1,
  "device": {
    "did": "xxx",
    "siid": 1,
    "aiid": 1,
    "argument": 1,
    "space": {
      "spaceId": "该设备所在空间ID",
      "rootId": "根空间ID"
    }
  },
  "polls": [
    {
      "index": 1,
      "name": "读进水温度",
      "request": {
        "slaveId": 1,
        "fc": "03",
        "start": 0,
        "quantity": 1
      },
      "response": {
        "fields": [
          {
            "index": 1,
            "field": "进水温度",
            "bytes": 2,
            "format": "uint16",
            "byteOrder": "ABCD",
            "scale": 0.1,
            "unit": "℃"
          }
        ]
      },
      "interval": 5,
      "polling": true,
      "from": {
        "type": "command",
        "index": 1
      }
    },
    {
      "index": 2,
      "name": "读开关状态",
      "request": {
        "slaveId": 1,
        "fc": "03",
        "start": 1,
        "quantity": 1
      },
      "response": {
        "fields": [
          {
            "index": 1,
            "field": "开关状态",
            "bytes": 2,
            "format": "uint16",
            "byteOrder": "ABCD",
            "scale": 1,
            "value-list": [
              {
                "value": 0,
                "description": "ON"
              },
              {
                "value": 1,
                "description": "OFF"
              }
            ]
          }
        ]
      },
      "from": {
        "type": "command",
        "index": 2
      }
    },
    {
      "index": 3,
      "name": "读8个开关量",
      "request": {
        "slaveId": 1,
        "fc": "01",
        "start": 0,
        "quantity": 8
      },
      "response": {
        "fields": [
          {
            "index": 1,
            "field": "线圈状态",
            "bytes": 1,
            "format": "uint8",
            "scale": 1,
            "bit-list": [
              {
                "offset": 0,
                "field": "进水阀"
              },
              {
                "offset": 3,
                "field": "报警"
              }
            ]
          }
        ]
      },
      "from": {
        "type": "command",
        "index": 3
      }
    },
    {
      "index": 4,
      "name": "读多个温度值",
      "request": {
        "slaveId": 1,
        "fc": "03",
        "start": 100,
        "quantity": 3
      },
      "response": {
        "fields": [
          {
            "index": 1,
            "field": "第一个温度值",
            "bytes": 2,
            "format": "uint16",
            "byteOrder": "ABCD",
            "scale": 0.1,
            "unit": "摄氏度"
          },
          {
            "index": 2,
            "field": "第二个温度值",
            "bytes": 2,
            "format": "uint16",
            "byteOrder": "ABCD",
            "scale": 0.1,
            "unit": "摄氏度"
          },
          {
            "index": 3,
            "field": "第三个温度值",
            "bytes": 2,
            "format": "uint16",
            "byteOrder": "ABCD",
            "scale": 0.1,
            "unit": "摄氏度"
          }
        ]
      },
      "from": {
        "type": "command",
        "index": 4
      }
    },
    {
      "index": 5,
      "name": "开机",
      "request": {
        "slaveId": 1,
        "fc": "05",
        "start": 0,
        "fields": [
          {
            "index": 1,
            "field": "开机",
            "format": "bit",
            "value": true
          }
        ]
      },
      "from": {
        "type": "command",
        "index": 5
      }
    },
    {
      "index": 6,
      "name": "写设定温度",
      "request": {
        "slaveId": 1,
        "fc": "06",
        "start": 1,
        "fields": [
          {
            "index": 1,
            "field": "设定温度",
            "format": "int16",
            "value": 70
          }
        ]
      },
      "from": {
        "type": "command",
        "index": 6
      }
    },
    {
      "index": 7,
      "name": "写一组开关量",
      "request": {
        "slaveId": 1,
        "fc": "0F",
        "start": 0,
        "fields": [
          {
            "index": 1,
            "field": "进水阀",
            "offset": 0,
            "format": "bit",
            "value": true
          },
          {
            "index": 2,
            "field": "报警复位",
            "offset": 1,
            "format": "bit"
          }
        ]
      },
      "from": {
        "type": "command",
        "index": 7
      }
    },
    {
      "index": 8,
      "name": "写运行参数",
      "request": {
        "slaveId": 1,
        "fc": "10",
        "start": 10,
        "fields": [
          {
            "index": 1,
            "field": "运行模式",
            "offset": 0,
            "format": "uint16",
            "value": 1
          },
          {
            "index": 2,
            "field": "设定温度",
            "offset": 1,
            "format": "float32",
            "byteOrder": "ABCD",
            "value": 7.5
          }
        ]
      },
      "from": {
        "type": "command",
        "index": 8
      }
    }
  ]
}